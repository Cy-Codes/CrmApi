meta {
  name: Create As User (201)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/{{provider}}/v1/hubspot/companies
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.CRM_USER_TOKEN}}
}

body:json {
  {
    "name": "Bruno Mutation Test Company"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("created_id", res.body.companyId);
}
