# ============================================================================
# CrmApiCSharp container runtime contract
# The image reads ONLY these variables, on every platform (local Docker, AWS
# ECS, Azure Container Apps). Terraform renders the cloud values from
# crm-infra/terraform/modules/shared/crm-runtime-config.
#
#   docker build -t crm-api-csharp .
#   docker run --rm -p 8081:8080 --env-file .env crm-api-csharp
#
# The defaults below target the CRMDatabaseMS / CRMDatabasePG containers
# started from their own docker-compose.yml files on the host.
# ============================================================================

# HTTP port inside the container
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_ENVIRONMENT=Production

# Microsoft SQL Server (provider code: ms)
ConnectionStrings__CRMDatabaseMS=Server=host.docker.internal,1433;Database=CRMDatabaseMS;User Id=sa;Password=CrmDev2026!Secure#Pass;Encrypt=True;TrustServerCertificate=True;

# PostgreSQL (provider code: pg)
ConnectionStrings__CRMDatabasePG=Host=host.docker.internal;Port=5432;Database=CRMDatabase;Username=postgres;Password=postgres;SSL Mode=Prefer;
